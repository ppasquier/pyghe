    given-names: Philippe
    orcid: "https://orcid.org/0000-0002-8589-1038"
license: MIT
repository-code: "https://github.com/ppasquier/pyghe"
url: "https://www.gheanalysis.com/pages/python-api"
keywords:
  - geothermal
  - ground heat exchanger
  - borehole
  - g-function
  - heat pump
preferred-citation:
